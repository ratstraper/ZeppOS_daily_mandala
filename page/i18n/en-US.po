//practice help
msgid "about_practice_slide_title"
msgstr "Daily Practice"

msgid "about_practice_slide_text"
msgstr "Each day has its own reflection in Mandala.\n\nOpen it. Let your gaze flow through the lines, colors, and patterns from edge to center and back. Breathe with it.\nObserve your current state.\nEven 3 minutes is enough."


msgid "about_practice_slide_title2"
msgstr "Track your"

msgid "about_practice_slide_text2"
msgstr "Streak - your current series of daily practises.\nBest - your personal record in streaks."

msgid "practice_intro_dont_show_again"
msgstr "Don't show again"

msgid "help_practice_slide3_action"
msgstr "Start"



//deep practice help
msgid "deep_practice_slide1_title"
msgstr "Go Deeper"

msgid "deep_practice_slide1_text"
msgstr "Daily Mandala helps you build the habit.\n\nYour BirthMandala makes the practice personal."

msgid "deep_practice_slide2_title"
msgstr "One Date"

msgid "deep_practice_slide2_text"
msgstr "A day that changed your life: your birthday or any meaningful date can be captured in a unique pattern of that day."

msgid "deep_practice_slide3_title"
msgstr "One Mandala"

msgid "deep_practice_slide3_text"
msgstr "Every calendar date has exactly one Mandala NFT. It can become yours and no one can mint a second Mandala for the same date."

msgid "deep_practice_slide4_title"
msgstr "One Owner"

msgid "deep_practice_slide4_text"
msgstr "Only one person can own it at a time.\nCheck on the website if your date is still available and mint your Mandala."

msgid "deep_practice_slide4_action"
msgstr "Check your date"

msgid "deep_link_to_mint"
msgstr "Check & Mint"

